+        #[arg(short, long, help = "output file", default_value_t = "output.obj".to_string())]
+        output: String,
+    }
+
+    assert_eq!(
+        Args {
+            source: "./tests/cube/main.kda".to_owned(),
+            output: "output.obj".to_owned(),
+        },
