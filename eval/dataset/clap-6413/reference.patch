+        Args::try_parse_from(["test", "--source", "input.kda", "--output", "mesh.obj"])
+            .unwrap()
+    );
+
+    let help = utils::get_long_help::<Args>();
+    assert!(help.contains("[default: ./tests/cube/main.kda]"));
+    assert!(help.contains("[default: output.obj]"));
