+++ b/tests/taskbelay_into_values.rs
@@ -0,0 +1,20 @@
+use serde_json::{Map, Value};
+
+#[test]
+fn owned_values_keep_order_and_iterator_contracts() {
+    let mut map = Map::new();
+    map.insert("c".into(), Value::from(3));
+    map.insert("a".into(), Value::from(1));
+    map.insert("b".into(), Value::from(2));
+    let expected: Vec<_> = map.values().cloned().collect();
+    let mut values = map.into_values();
+    assert_eq!(values.len(), 3);
+    assert_eq!(values.size_hint(), (3, Some(3)));
+    assert_eq!(values.next(), Some(expected[0].clone()));
+    assert_eq!(values.next_back(), Some(expected[2].clone()));
+    assert_eq!(values.len(), 1);
+    assert_eq!(values.next(), Some(expected[1].clone()));
+    assert_eq!(values.next(), None);
+    assert_eq!(values.next_back(), None);
+    assert_eq!(Map::new().into_values().count(), 0);
+}
