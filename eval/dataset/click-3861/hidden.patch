@@ -0,0 +1,24 @@
+import click
+import pytest
+
+
+class CustomParameter(click.Parameter):
+    def _parse_decls(self, decls, expose_value):
+        return "name", [], []
+
+    def add_to_parser(self, parser, ctx):
+        pass
+
+
+@pytest.mark.parametrize("help_in,expected", [
+    (None, None), ("", ""), ("  first\n    second", "first\nsecond"),
+])
+def test_custom_parameter_help_contract(help_in, expected):
+    parameter = CustomParameter(["name"], help=help_in)
+    assert parameter.help == expected
+    assert parameter.to_info_dict()["help"] == expected
+
+
+def test_custom_parameter_deprecated_help_contract():
+    parameter = CustomParameter(["name"], help="Old input", deprecated="use replacement")
+    assert parameter.to_info_dict()["help"] == "Old input (DEPRECATED: use replacement)"
