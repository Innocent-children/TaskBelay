+++ b/tests/taskbelay_sequence_map.rs
@@ -0,0 +1,31 @@
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+
+#[test]
+fn sequence_and_map_values_keep_reader_and_slice_behavior() {
+    let input = br#" [ {}, [], {"x":[1,true,null,"text"]}, {"x":1,"x":2} ] "#;
+    let expected = json!([{}, [], {"x":[1,true,null,"text"]}, {"x":2}]);
+    assert_eq!(serde_json::from_slice::<Value>(input).unwrap(), expected);
+    assert_eq!(serde_json::from_reader::<_, Value>(&input[..]).unwrap(), expected);
+    assert_eq!(serde_json::from_str::<Vec<i64>>(" [ 1, 2, 3 ] ").unwrap(), vec![1, 2, 3]);
+    let borrowed: BTreeMap<&str, Vec<&str>> =
+        serde_json::from_str(r#"{"items":["first","second"]}"#).unwrap();
+    assert_eq!(borrowed["items"], vec!["first", "second"]);
+}
+
+#[test]
+fn sequence_and_map_syntax_errors_keep_category_and_position() {
+    for input in ["[1,]", "[1 2]", "{\"a\":1,}", "{\"a\":1 \"b\":2}", "{1:2}"] {
+        let slice = serde_json::from_slice::<Value>(input.as_bytes()).unwrap_err();
+        let reader = serde_json::from_reader::<_, Value>(input.as_bytes()).unwrap_err();
+        assert!(slice.is_syntax(), "{}: {}", input, slice);
+        assert_eq!(slice.to_string(), reader.to_string());
+        assert!(slice.line() > 0 && slice.column() > 0);
+    }
+    for input in ["[", "[1,", "{", "{\"a\":1,"] {
+        let slice = serde_json::from_slice::<Value>(input.as_bytes()).unwrap_err();
+        let reader = serde_json::from_reader::<_, Value>(input.as_bytes()).unwrap_err();
+        assert!(slice.is_eof(), "{}: {}", input, slice);
+        assert_eq!(slice.to_string(), reader.to_string());
+    }
+}
