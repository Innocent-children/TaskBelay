+package cobra_test
+
+import (
+	"bytes"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	"github.com/spf13/cobra"
+)
+
+func TestTaskBelayBashCompletionOutput(t *testing.T) {
+	bash, err := exec.LookPath("bash")
+	if err != nil { t.Fatal("Bash is required for this evaluation", err) }
+	var generated bytes.Buffer
+	if err := (&cobra.Command{Use: "taskbelayfixture"}).GenBashCompletionV2(&generated, true); err != nil { t.Fatal(err) }
+	path := filepath.Join(t.TempDir(), "completion.bash")
+	if err := os.WriteFile(path, generated.Bytes(), 0600); err != nil { t.Fatal(err) }
+	for _, tc := range []struct{prefix, width, want string}{
+		{"al", "80", "alpha\n"},
+		{"a", "80", "alpha  (first)\namber  (second)\n"},
+		{"b", "80", "beta\n"},
+		{"a", "8", "alpha\namber\n"},
+		{"missing", "80", ""},
+	} {
+		t.Run(tc.prefix+tc.width, func(t *testing.T) {
+			script := `source "$1"
+PREFIX="$2"; COLUMNS="$3"
+taskbelayfixture() { printf 'alpha\tfirst\namber\tsecond\nbeta\tthird\n:0\n'; }
+_init_completion() { cur="$PREFIX"; prev=taskbelayfixture; words=(taskbelayfixture "$PREFIX"); cword=1; }
+read -r -a registration <<< "$(complete -p taskbelayfixture)"
+for ((i=0;i<${#registration[@]};i++)); do
+    if [[ ${registration[i]} == -F ]]; then completion_function=${registration[i+1]}; fi
+done
+"$completion_function"
+for item in "${COMPREPLY[@]}"; do printf '%s\n' "$item"; done
+`
+			command := exec.Command(bash, "--noprofile", "--norc", "-c", script, "fixture", path, tc.prefix, tc.width)
+			output, err := command.CombinedOutput()
+			if err != nil || string(output) != tc.want { t.Fatalf("output=%q want=%q error=%v", output, tc.want, err) }
+		})
+	}
+}
