--- /dev/null
+++ b/clap_complete/tests/taskbelay_possible_values.rs
@@ -0,0 +1,23 @@
+#![cfg(feature = "unstable-dynamic")]
+
+use clap::builder::PossibleValue;
+use clap_complete::engine::{complete_possible_values, possible_value_candidates};
+use std::ffi::OsStr;
+
+#[test]
+fn public_possible_values_keep_metadata_and_prefix_behavior() {
+    let values = vec![PossibleValue::new("alpha").help("first"),
+        PossibleValue::new("amber").hide(true), PossibleValue::new("beta")];
+    let all = possible_value_candidates(values.clone());
+    assert_eq!(all.len(), 3);
+    assert_eq!(all[0].get_value(), OsStr::new("alpha"));
+    assert_eq!(all[0].get_help().unwrap().to_string(), "first");
+    assert!(all[1].is_hide_set());
+    let matching = complete_possible_values(OsStr::new("a"), values.clone());
+    assert_eq!(matching.len(), 2);
+    assert_eq!(matching[0].get_value(), OsStr::new("alpha"));
+    assert_eq!(matching[1].get_value(), OsStr::new("amber"));
+    assert!(matching[1].is_hide_set());
+    assert_eq!(complete_possible_values(OsStr::new(""), values.clone()).len(), 3);
+    assert!(complete_possible_values(OsStr::new("missing"), values).is_empty());
+}
