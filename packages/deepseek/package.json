{
  "name": "taskbelay-deepseek",
  "version": "0.10.6",
  "private": false,
  "description": "TaskBelay local engineering control and evidence for deepseek.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Innocent-children/taskbelay.git",
    "directory": "packages/deepseek"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "lib/authorization.mjs",
    "lib/file-scope.mjs",
    "lib/index.mjs",
    "lib/paths.mjs",
    "lib/platform.mjs",
    "lib/platform/macos/policies.mjs",
    "lib/platform/windows/policies.mjs",
    "lib/provisioning-receipt.mjs",
    "lib/runtime.mjs",
    "lib/tool-names.mjs",
    "lib/workspace-coordinator.mjs",
    "lib/workspace-tool.mjs",
    "runtime/darwin-arm64/taskbelay",
    "runtime/win32-x64/taskbelay.exe",
    "skills/taskbelay/SKILL.md",
    "lib/worktree-snapshot.mjs",
    "skills/taskbelay/references/engineering.md",
    "skills/taskbelay/references/protocol.md",
    "skills/taskbelay/references/workspace.md",
    "lib/repository-freshness.mjs",
    "lib/worktree-lifecycle.mjs",
    "lib/integration-receipt.mjs",
    "lib/interface-reference.mjs",
    "contracts/interfaces.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:package": "node --test tests/package-contract.test.mjs",
    "test:bundle": "node --test tests/bundle-contract.test.mjs",
    "build:webui": "node ../../scripts/build-webui.mjs",
    "build:local": "node ../../scripts/build-deepseek-local.mjs",
    "pack:dry": "pnpm pack --dry-run --json"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-skill": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.1.2-rc.1"
  }
}
